{
	"name": "PL_Customer_Incremental_copy1",
	"properties": {
		"activities": [
			{
				"name": "Lookup_Watermark",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat('SELECT last_watermark FROM dbo.ETL_Watermark WHERE source_table = ''', pipeline().parameters.pTableName, '''')",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "dsCust",
						"type": "DatasetReference",
						"parameters": {
							"pTableName": {
								"value": "@pipeline().parameters.pETLName",
								"type": "Expression"
							}
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Set_Current_Watermark",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Lookup_Watermark",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "current_watermark",
					"value": {
						"value": "@formatDateTime(utcNow(),'yyyy-MM-dd HH:mm:ss')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Copy data1",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Set_Current_Watermark",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat(\n    'SELECT customer_id, customer_name, region, channel, last_modified ',\n    'FROM ', pipeline().parameters.pTableName, ' ',\n    'WHERE last_modified > ''',\n    activity('Lookup_Watermark').output.value[0].last_watermark,\n    ''' AND last_modified <= ''',\n    variables('current_watermark'),\n    ''''\n)",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobStorageWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "dsCust",
						"type": "DatasetReference",
						"parameters": {
							"pTableName": {
								"value": "@pipeline().parameters.pTableName",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "ds_BRONZE_CUST",
						"type": "DatasetReference",
						"parameters": {
							"pFileName": {
								"value": "@pipeline().parameters.pFileName",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "Script1",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "Copy data1",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "AzureSqlDatabase2",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": "@concat(\n    'UPDATE dbo.ETL_Watermark SET last_watermark = ''',\n    variables('current_watermark'),\n    ''' WHERE source_table = ''',\n    pipeline().parameters.pTableName,\n    ''''\n)"
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			}
		],
		"parameters": {
			"pTableName": {
				"type": "string",
				"defaultValue": "Customer"
			},
			"pETLName": {
				"type": "string",
				"defaultValue": "ETL_Watermark"
			},
			"pFileName": {
				"type": "string",
				"defaultValue": "Customer"
			}
		},
		"variables": {
			"current_watermark": {
				"type": "String"
			},
			"last_modified": {
				"type": "String"
			}
		},
		"folder": {
			"name": "use_case"
		},
		"annotations": []
	}
}