{
	"name": "pipeline6",
	"properties": {
		"activities": [
			{
				"name": "Delete1",
				"type": "Delete",
				"dependsOn": [
					{
						"activity": "Set variable1",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [
					{
						"name": "files deleting activity",
						"value": "outbound files are getting deleted"
					}
				],
				"typeProperties": {
					"dataset": {
						"referenceName": "adlsfolder",
						"type": "DatasetReference"
					},
					"logStorageSettings": {
						"linkedServiceName": {
							"referenceName": "AzureBlobStorage1",
							"type": "LinkedServiceReference"
						},
						"path": "fayaz-container-demo/fayaz-demo-input"
					},
					"enableLogging": true,
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true,
						"wildcardFileName": {
							"value": "@variables('ext')",
							"type": "Expression"
						},
						"enablePartitionDiscovery": false
					}
				}
			},
			{
				"name": "Set variable1",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "ext",
					"value": {
						"value": "@concat(pipeline().parameters.file_name,pipeline().parameters.ext)",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"file_name": {
				"type": "string",
				"defaultValue": "test"
			},
			"ext": {
				"type": "string",
				"defaultValue": ".txt"
			}
		},
		"variables": {
			"ext": {
				"type": "String",
				"defaultValue": ".txt"
			}
		},
		"annotations": []
	}
}